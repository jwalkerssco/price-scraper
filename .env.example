# Copy this file to .env for local use. Never commit .env.
# On Replit, add these as Secrets instead (workspace AND deployment).

APIFY_TOKEN=paste_your_token_here

# Leave blank locally to use a SQLite file. Set to your Postgres connection string in production.
DATABASE_URL=

# Optional: push alerts via ntfy. Use a long random topic name (topics are public by name).
NTFY_TOPIC=

# Optional: set to 0 to skip saving raw JSON files (use in production).
SAVE_RAW=1
